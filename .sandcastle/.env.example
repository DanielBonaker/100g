# Copy to .sandcastle/.env and fill in real values.
# .env is gitignored; .env.example is committed as documentation.

# Anthropic API key — billed per token, separate from your Claude Code subscription.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional — set a soft monthly cap to refuse new runs over budget.
# SANDCASTLE_MONTHLY_BUDGET_USD=50
